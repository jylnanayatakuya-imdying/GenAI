{
  "task_id": "M03_MovingAvg",
  "title": "Calculate Moving Average",
  "pou": "M03_MovingAvg",
  "scan_ms": 20,
  "interface": [
    {
      "name": "cyclicExecution",
      "dir": "input",
      "type": "BOOL",
      "desc": "read every cycle"
    },
    {
      "name": "trigger",
      "dir": "input",
      "type": "BOOL",
      "desc": "read on rising edge"
    },
    {
      "name": "value",
      "dir": "input",
      "type": "LREAL",
      "desc": "new data value"
    },
    {
      "name": "windowSize",
      "dir": "input",
      "type": "INT",
      "desc": "window size 1..100"
    },
    {
      "name": "reset",
      "dir": "input",
      "type": "BOOL",
      "desc": "reset the calculation"
    },
    {
      "name": "average",
      "dir": "output",
      "type": "LREAL",
      "desc": "moving average"
    },
    {
      "name": "windowSizeReached",
      "dir": "output",
      "type": "BOOL",
      "desc": "window full"
    },
    {
      "name": "error",
      "dir": "output",
      "type": "BOOL",
      "desc": "error flag"
    },
    {
      "name": "status",
      "dir": "output",
      "type": "WORD",
      "desc": "16#0000 ok, 16#8200 window error"
    }
  ],
  "cases": [
    {
      "id": "TC01",
      "name": "Cyclic moving average with window 3",
      "coverage": "average over a partially filled window, window reached, oldest value replaced",
      "initial_state": "power-up, windowSize=3, cyclicExecution=TRUE",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 10.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 10.0,
            "windowSizeReached": 0,
            "error": 0,
            "status": 0
          },
          "check": "first value: average = 10"
        },
        {
          "cycle": 1,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 20.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 15.0,
            "windowSizeReached": 0
          },
          "check": "two values: (10+20)/2 = 15"
        },
        {
          "cycle": 2,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 30.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 20.0,
            "windowSizeReached": 1
          },
          "check": "three values: (10+20+30)/3 = 20, window reached"
        },
        {
          "cycle": 3,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 60.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 36.666666666666664,
            "windowSizeReached": 1
          },
          "check": "oldest (10) dropped: (20+30+60)/3"
        },
        {
          "cycle": 4,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 90.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 60.0,
            "windowSizeReached": 1
          },
          "check": "(30+60+90)/3 = 60"
        }
      ]
    },
    {
      "id": "TC02",
      "name": "Trigger mode reads only on a rising edge",
      "coverage": "no read without a trigger, one read per rising edge, held trigger does not read again",
      "initial_state": "power-up, windowSize=2, cyclicExecution=FALSE",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "cyclicExecution": 0,
            "trigger": 0,
            "value": 10.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 0.0,
            "windowSizeReached": 0
          },
          "check": "no trigger -> nothing read"
        },
        {
          "cycle": 1,
          "inputs": {
            "cyclicExecution": 0,
            "trigger": 1,
            "value": 10.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 10.0
          },
          "check": "rising edge -> value read"
        },
        {
          "cycle": 2,
          "inputs": {
            "cyclicExecution": 0,
            "trigger": 1,
            "value": 99.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 10.0
          },
          "check": "trigger held -> no new read"
        },
        {
          "cycle": 3,
          "inputs": {
            "cyclicExecution": 0,
            "trigger": 0,
            "value": 99.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 10.0
          },
          "check": "trigger released -> no read"
        },
        {
          "cycle": 4,
          "inputs": {
            "cyclicExecution": 0,
            "trigger": 1,
            "value": 30.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 20.0,
            "windowSizeReached": 1
          },
          "check": "new rising edge -> (10+30)/2 = 20"
        }
      ]
    },
    {
      "id": "TC03",
      "name": "cyclicExecution overrides the trigger",
      "coverage": "with cyclicExecution TRUE a value is read every cycle regardless of the trigger",
      "initial_state": "power-up, windowSize=2, cyclicExecution=TRUE",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 4.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 4.0
          },
          "check": "read without a trigger"
        },
        {
          "cycle": 1,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 8.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 6.0,
            "windowSizeReached": 1
          },
          "check": "read again: (4+8)/2 = 6"
        },
        {
          "cycle": 2,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 1,
            "value": 12.0,
            "windowSize": 2,
            "reset": 0
          },
          "expect": {
            "average": 10.0
          },
          "check": "trigger has no additional effect: (8+12)/2 = 10"
        }
      ]
    },
    {
      "id": "TC04",
      "name": "Reset clears the calculation",
      "coverage": "reset zeroes the average and the window, new values start from scratch",
      "initial_state": "power-up, windowSize=3, cyclicExecution=TRUE",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 10.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 10.0
          },
          "check": "first value"
        },
        {
          "cycle": 1,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 20.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 15.0
          },
          "check": "second"
        },
        {
          "cycle": 2,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 30.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 20.0,
            "windowSizeReached": 1
          },
          "check": "window reached"
        },
        {
          "cycle": 3,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 99.0,
            "windowSize": 3,
            "reset": 1
          },
          "expect": {
            "average": 0.0,
            "windowSizeReached": 0,
            "error": 0
          },
          "check": "reset -> average 0, window not reached"
        },
        {
          "cycle": 4,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 50.0,
            "windowSize": 3,
            "reset": 0
          },
          "expect": {
            "average": 50.0,
            "windowSizeReached": 0
          },
          "check": "restart: only the new value counts"
        }
      ]
    },
    {
      "id": "TC05",
      "name": "Window-size errors",
      "coverage": "windowSize 0 and 101 produce 16#8200, boundaries 1 and 100 are valid, recovery after a valid size",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 10.0,
            "windowSize": 0,
            "reset": 0
          },
          "expect": {
            "error": 1,
            "status": 33280
          },
          "check": "windowSize 0 -> error 16#8200"
        },
        {
          "cycle": 1,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 10.0,
            "windowSize": 101,
            "reset": 0
          },
          "expect": {
            "error": 1,
            "status": 33280
          },
          "check": "windowSize 101 -> error"
        },
        {
          "cycle": 2,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 10.0,
            "windowSize": -5,
            "reset": 0
          },
          "expect": {
            "error": 1,
            "status": 33280
          },
          "check": "negative window -> error"
        },
        {
          "cycle": 3,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 10.0,
            "windowSize": 1,
            "reset": 0
          },
          "expect": {
            "average": 10.0,
            "windowSizeReached": 1,
            "error": 0,
            "status": 0
          },
          "check": "windowSize 1 is valid, average = value"
        },
        {
          "cycle": 4,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 20.0,
            "windowSize": 1,
            "reset": 0
          },
          "expect": {
            "average": 20.0,
            "windowSizeReached": 1,
            "error": 0
          },
          "check": "window 1: average follows the latest value"
        },
        {
          "cycle": 5,
          "inputs": {
            "cyclicExecution": 1,
            "trigger": 0,
            "value": 20.0,
            "windowSize": 100,
            "reset": 0
          },
          "expect": {
            "error": 0,
            "status": 0
          },
          "check": "windowSize 100 is valid"
        }
      ]
    }
  ]
}