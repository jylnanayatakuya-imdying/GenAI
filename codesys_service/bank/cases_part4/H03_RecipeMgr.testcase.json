      "id": "TC01",
      "name": "Add recipes and reject duplicates",
      "coverage": "add into the lowest free slot, duplicate ID -> 16#8002",
      "initial_state": "power-up, empty database (all recipeID = 0)",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "addRecipe": 1,
            "deleteRecipe": 0,
            "modifyRecipe": 0,
            "queryRecipe": 0,
            "recipeIn.recipeID": 101,
            "recipeIn.ingredientType": 1,
            "recipeIn.ingredientRatio": 0.5,
            "recipeIn.productionTemperature": 180.0
          },
          "expect": {
            "recipeAdded": 1,
            "error": 0,
            "status": 0
          },
          "check": "first recipe added"
