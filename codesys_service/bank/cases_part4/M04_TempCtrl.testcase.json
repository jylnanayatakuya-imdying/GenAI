{
  "task_id": "M04_TempCtrl",
  "title": "Temperature Logic Control",
  "pou": "M04_TempCtrl",
  "scan_ms": 20,
  "interface": [
    {
      "name": "TemperatureSensorInput",
      "dir": "input",
      "type": "REAL",
      "desc": "measured temperature"
    },
    {
      "name": "SetTemperature",
      "dir": "input",
      "type": "REAL",
      "desc": "setpoint"
    },
    {
      "name": "CurrentTemperature",
      "dir": "output",
      "type": "REAL",
      "desc": "current temperature display"
    },
    {
      "name": "SetTempDisplay",
      "dir": "output",
      "type": "REAL",
      "desc": "setpoint display"
    },
    {
      "name": "HeaterStatus",
      "dir": "output",
      "type": "BOOL",
      "desc": "heater status display"
    },
    {
      "name": "OverheatProtection",
      "dir": "output",
      "type": "BOOL",
      "desc": "overheat protection active"
    },
    {
      "name": "HeaterOutput",
      "dir": "output",
      "type": "BOOL",
      "desc": "heater control output"
    }
  ],
  "cases": [
    {
      "id": "TC01",
      "name": "Basic heating control and status display",
      "coverage": "heater on below setpoint, off above, display mirrors inputs",
      "initial_state": "power-up, all outputs OFF",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "TemperatureSensorInput": 25.0,
            "SetTemperature": 30.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0,
            "CurrentTemperature": 25.0,
            "SetTempDisplay": 30.0
          },
          "check": "below setpoint -> heater on, displays mirror inputs"
        },
        {
          "cycle": 1,
          "inputs": {
            "TemperatureSensorInput": 29.9,
            "SetTemperature": 30.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "CurrentTemperature": 29.9
          },
          "check": "still below -> heating"
        },
        {
          "cycle": 2,
          "inputs": {
            "TemperatureSensorInput": 35.0,
            "SetTemperature": 30.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0,
            "CurrentTemperature": 35.0
          },
          "check": "above setpoint -> heater off"
        },
        {
          "cycle": 3,
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 30.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0
          },
          "check": "equal to setpoint -> not below -> heater off"
        },
        {
          "cycle": 4,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "SetTempDisplay": 50.0
          },
          "check": "new setpoint, below -> heating"
        }
      ]
    },
    {
      "id": "TC02",
      "name": "Overheat protection after 5 s of continuous heating",
      "coverage": "protection trips at 5s, heater forced off, protection held for 3s, released afterwards",
      "initial_state": "power-up, temperature 20, setpoint 80 (heater stays demanded)",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0
          },
          "check": "heating starts",
          "hold_ms": 3000
        },
        {
          "cycle": 1,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0
          },
          "check": "3s of continuous heating: no protection yet",
          "hold_ms": 1900
        },
        {
          "cycle": 2,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0,
            "OverheatProtection": 1
          },
          "check": "5s reached -> protection trips, heater off",
          "hold_ms": 200
        },
        {
          "cycle": 3,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0,
            "OverheatProtection": 1
          },
          "check": "protection held, heater stays off although demand persists",
          "hold_ms": 2000
        },
        {
          "cycle": 4,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0,
            "OverheatProtection": 1
          },
          "check": "2.9 s of the 3 s wait: protection still active",
          "hold_ms": 700
        },
        {
          "cycle": 5,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "OverheatProtection": 0
          },
          "check": "3 s elapsed -> protection lifted (heater restarts in the next cycle)",
          "hold_ms": 200
        },
        {
          "cycle": 6,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0
          },
          "check": "heating resumes"
        }
      ]
    },
    {
      "id": "TC03",
      "name": "Sensor fault turns the heater off",
      "coverage": "value < 0 and > 100 are faults, heater off, recovery when the value returns to range",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1
          },
          "check": "normal heating"
        },
        {
          "cycle": 1,
          "inputs": {
            "TemperatureSensorInput": -0.1,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0
          },
          "check": "value < 0 -> sensor fault, heater off"
        },
        {
          "cycle": 2,
          "inputs": {
            "TemperatureSensorInput": 0.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1
          },
          "check": "0 is a valid value -> heating again"
        },
        {
          "cycle": 3,
          "inputs": {
            "TemperatureSensorInput": 100.1,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0
          },
          "check": "value > 100 -> sensor fault, heater off"
        },
        {
          "cycle": 4,
          "inputs": {
            "TemperatureSensorInput": 100.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0
          },
          "check": "100 is valid but above setpoint -> heater off"
        },
        {
          "cycle": 5,
          "inputs": {
            "TemperatureSensorInput": 100.0,
            "SetTemperature": 120.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1
          },
          "check": "100 valid and below setpoint -> heating"
        }
      ]
    },
    {
      "id": "TC04",
      "name": "Heating interrupted before 5 s does not trip protection",
      "coverage": "the run timer restarts when the heater stops",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0
          },
          "check": "heating",
          "hold_ms": 3000
        },
        {
          "cycle": 1,
          "inputs": {
            "TemperatureSensorInput": 90.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 0,
            "HeaterStatus": 0,
            "OverheatProtection": 0
          },
          "check": "above setpoint -> heater off before 5s, no protection"
        },
        {
          "cycle": 2,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0
          },
          "check": "heating again",
          "hold_ms": 3000
        },
        {
          "cycle": 3,
          "inputs": {
            "TemperatureSensorInput": 20.0,
            "SetTemperature": 80.0
          },
          "expect": {
            "HeaterOutput": 1,
            "HeaterStatus": 1,
            "OverheatProtection": 0
          },
          "check": "3s of the new heating period: still no protection",
          "hold_ms": 1000
        }
      ]
    }
  ]
}