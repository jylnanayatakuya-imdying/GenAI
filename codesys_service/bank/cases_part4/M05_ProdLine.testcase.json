     "expect": {
      "MotorForward": 1,
      "MotorReverse": 0,
      "CompletionLight": 0
     },
     "check": "forward button -> forward"
    },
    {
     "cycle": 2,
     "inputs": {
      "Mode": 0,
      "ForwardButton": 0,
      "ReverseButton": 0,
      "SensorA": 0,
      "SensorB": 0,
      "SensorC": 0,
      "ButtonA": 0,
      "ButtonB": 0,
      "ButtonC": 0
     },
     "expect": {
      "MotorForward": 0,
      "MotorReverse": 0,
      "CompletionLight": 0
     },
     "check": "released -> stop (jog, no latching)"
    },
    {
     "cycle": 3,
     "inputs": {
      "Mode": 0,
      "ForwardButton": 0,
      "ReverseButton": 1,
      "SensorA": 0,
      "SensorB": 0,
      "SensorC": 0,
      "ButtonA": 0,
      "ButtonB": 0,
      "ButtonC": 0
     },
     "expect": {
      "MotorForward": 0,
      "MotorReverse": 1,
      "CompletionLight": 0
     },
     "check": "reverse button -> reverse"
    },
    {
     "cycle": 4,
