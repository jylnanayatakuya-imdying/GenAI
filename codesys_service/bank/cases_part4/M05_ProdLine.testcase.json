   "coverage": "forward, reverse, both pressed -> both OFF, release -> stop, light OFF in manual",
   "initial_state": "power-up, Mode=0 (manual), all inputs FALSE",
   "steps": [
    {
     "cycle": 0,
     "inputs": {
      "Mode": 0,
      "ForwardButton": 0,
      "ReverseButton": 0,
      "SensorA": 0,
      "SensorB": 0,
      "SensorC": 0,
      "ButtonA": 0,
      "ButtonB": 0,
      "ButtonC": 0
     },
     "expect": {
      "MotorForward": 0,
      "MotorReverse": 0,
      "CompletionLight": 0
     },
     "check": "idle manual, all OFF"
    },
    {
     "cycle": 1,
     "inputs": {
      "Mode": 0,
      "ForwardButton": 1,
      "ReverseButton": 0,
      "SensorA": 0,
      "SensorB": 0,
      "SensorC": 0,
      "ButtonA": 0,
      "ButtonB": 0,
      "ButtonC": 0
