{
  "task_id": "M01_PumpSwitch",
  "title": "Multi-Pump Switching Control System",
  "pou": "M01_PumpSwitch",
  "scan_ms": 20,
  "interface": [
    {
      "name": "mode",
      "dir": "input",
      "type": "BOOL",
      "desc": "FALSE manual, TRUE automatic"
    },
    {
      "name": "start",
      "dir": "input",
      "type": "BOOL",
      "desc": "start button"
    },
    {
      "name": "stop",
      "dir": "input",
      "type": "BOOL",
      "desc": "stop button"
    },
    {
      "name": "pumpGroup[1].priority",
      "dir": "input",
      "type": "INT",
      "desc": "priority of pump 1"
    },
    {
      "name": "pumpGroup[2].priority",
      "dir": "input",
      "type": "INT",
      "desc": "priority of pump 2"
    },
    {
      "name": "pumpGroup[3].priority",
      "dir": "input",
      "type": "INT",
      "desc": "priority of pump 3"
    },
    {
      "name": "pumpGroup[4].priority",
      "dir": "input",
      "type": "INT",
      "desc": "priority of pump 4"
    },
    {
      "name": "pumpGroup[5].priority",
      "dir": "input",
      "type": "INT",
      "desc": "priority of pump 5"
    },
    {
      "name": "pumpGroup[1].selection",
      "dir": "input",
      "type": "BOOL",
      "desc": "manual selection of pump 1"
    },
    {
      "name": "pumpGroup[2].selection",
      "dir": "input",
      "type": "BOOL",
      "desc": "manual selection of pump 2"
    },
    {
      "name": "pumpGroup[3].selection",
      "dir": "input",
      "type": "BOOL",
      "desc": "manual selection of pump 3"
    },
    {
      "name": "pumpGroup[4].selection",
      "dir": "input",
      "type": "BOOL",
      "desc": "manual selection of pump 4"
    },
    {
      "name": "pumpGroup[5].selection",
      "dir": "input",
      "type": "BOOL",
      "desc": "manual selection of pump 5"
    },
    {
      "name": "pumpGroup[1].RunComd",
      "dir": "output",
      "type": "BOOL",
      "desc": "run command of pump 1"
    },
    {
      "name": "pumpGroup[2].RunComd",
      "dir": "output",
      "type": "BOOL",
      "desc": "run command of pump 2"
    },
    {
      "name": "pumpGroup[3].RunComd",
      "dir": "output",
      "type": "BOOL",
      "desc": "run command of pump 3"
    },
    {
      "name": "pumpGroup[4].RunComd",
      "dir": "output",
      "type": "BOOL",
      "desc": "run command of pump 4"
    },
    {
      "name": "pumpGroup[5].RunComd",
      "dir": "output",
      "type": "BOOL",
      "desc": "run command of pump 5"
    }
  ],
  "cases": [
    {
      "id": "TC01",
      "name": "Manual mode runs the selected pumps",
      "coverage": "start runs selected pumps, selection changes are followed, stop stops all",
      "initial_state": "power-up, mode=0 (manual), no pump running",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "mode": 0,
            "start": 0,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 1,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 1,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "not started yet -> all stopped"
        },
        {
          "cycle": 1,
          "inputs": {
            "mode": 0,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 1,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 1,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 1,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "start -> selected pumps 1 and 3 run"
        },
        {
          "cycle": 2,
          "inputs": {
            "mode": 0,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 1,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 1,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 1,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "button released -> still running"
        },
        {
          "cycle": 3,
          "inputs": {
            "mode": 0,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 1,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 1,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 1
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 1,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 1
          },
          "check": "selection changed -> pumps follow"
        },
        {
          "cycle": 4,
          "inputs": {
            "mode": 0,
            "start": 0,
            "stop": 1,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 1,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 1,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 1
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "stop -> all pumps stop"
        },
        {
          "cycle": 5,
          "inputs": {
            "mode": 0,
            "start": 0,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 1,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 1,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 1
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "stays stopped until start"
        }
      ]
    },
    {
      "id": "TC02",
      "name": "Automatic mode runs the three highest priorities",
      "coverage": "3 duty / 2 standby selection, priority ranking, selection ignored in auto",
      "initial_state": "power-up, mode=1 (automatic)",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "mode": 1,
            "start": 0,
            "stop": 0,
            "pumpGroup[1].priority": 10,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 50,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 30,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 40,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 20,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "not started yet"
        },
        {
          "cycle": 1,
          "inputs": {
            "mode": 1,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 10,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 50,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 30,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 40,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 20,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 1,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 1,
            "pumpGroup[5].RunComd": 0
          },
          "check": "top three priorities (50,40,30) = pumps 2,4,3"
        },
        {
          "cycle": 2,
          "inputs": {
            "mode": 1,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 10,
            "pumpGroup[1].selection": 1,
            "pumpGroup[2].priority": 50,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 30,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 40,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 20,
            "pumpGroup[5].selection": 1
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 1,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 1,
            "pumpGroup[5].RunComd": 0
          },
          "check": "manual selection ignored in automatic mode"
        },
        {
          "cycle": 3,
          "inputs": {
            "mode": 1,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 90,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 10,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 20,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 30,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 40,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 1,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 1,
            "pumpGroup[5].RunComd": 1
          },
          "check": "priorities changed -> pumps 1,5,4 run"
        },
        {
          "cycle": 4,
          "inputs": {
            "mode": 1,
            "start": 0,
            "stop": 1,
            "pumpGroup[1].priority": 90,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 10,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 20,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 30,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 40,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "stop -> all stop"
        }
      ]
    },
    {
      "id": "TC03",
      "name": "Mode switching and priority ties",
      "coverage": "switching between manual and automatic, equal priorities still select exactly three pumps",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "mode": 0,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 1,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 1,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 1,
            "pumpGroup[2].RunComd": 1,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "manual: two selected pumps"
        },
        {
          "cycle": 1,
          "inputs": {
            "mode": 1,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 5,
            "pumpGroup[1].selection": 1,
            "pumpGroup[2].priority": 4,
            "pumpGroup[2].selection": 1,
            "pumpGroup[3].priority": 3,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 2,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 1,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 1,
            "pumpGroup[2].RunComd": 1,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "switch to automatic -> top three (5,4,3)"
        },
        {
          "cycle": 2,
          "inputs": {
            "mode": 0,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 0,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 0,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 0,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 0,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 0,
            "pumpGroup[5].selection": 1
          },
          "expect": {
            "pumpGroup[1].RunComd": 0,
            "pumpGroup[2].RunComd": 0,
            "pumpGroup[3].RunComd": 0,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 1
          },
          "check": "back to manual -> only the selected pump"
        },
        {
          "cycle": 3,
          "inputs": {
            "mode": 1,
            "start": 1,
            "stop": 0,
            "pumpGroup[1].priority": 7,
            "pumpGroup[1].selection": 0,
            "pumpGroup[2].priority": 7,
            "pumpGroup[2].selection": 0,
            "pumpGroup[3].priority": 7,
            "pumpGroup[3].selection": 0,
            "pumpGroup[4].priority": 7,
            "pumpGroup[4].selection": 0,
            "pumpGroup[5].priority": 7,
            "pumpGroup[5].selection": 0
          },
          "expect": {
            "pumpGroup[1].RunComd": 1,
            "pumpGroup[2].RunComd": 1,
            "pumpGroup[3].RunComd": 1,
            "pumpGroup[4].RunComd": 0,
            "pumpGroup[5].RunComd": 0
          },
          "check": "all priorities equal -> exactly three pumps run"
        }
      ]
    }
  ],
  "notes": "`start` is a level signal in the Part-2 reference (RunComd := start AND ...)."
}