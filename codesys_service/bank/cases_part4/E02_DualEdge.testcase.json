{
  "task_id": "E02_DualEdge",
  "title": "Dual-Word Edge Detection",
  "pou": "E02_DualEdge",
  "scan_ms": 20,
  "interface": [
    {
      "name": "value",
      "dir": "input",
      "type": "DWORD",
      "desc": "input value to check"
    },
    {
      "name": "hasChanged",
      "dir": "output",
      "type": "BOOL",
      "desc": "value changed"
    },
    {
      "name": "hasRisingEdges",
      "dir": "output",
      "type": "BOOL",
      "desc": "any rising edge"
    },
    {
      "name": "risingBits",
      "dir": "output",
      "type": "DWORD",
      "desc": "rising-edge bit mask"
    },
    {
      "name": "noOfRisingBits",
      "dir": "output",
      "type": "USINT",
      "desc": "number of rising edges"
    },
    {
      "name": "hasFallingEdges",
      "dir": "output",
      "type": "BOOL",
      "desc": "any falling edge"
    },
    {
      "name": "fallingBits",
      "dir": "output",
      "type": "DWORD",
      "desc": "falling-edge bit mask"
    },
    {
      "name": "noOfFallingBits",
      "dir": "output",
      "type": "USINT",
      "desc": "number of falling edges"
    }
  ],
  "cases": [
    {
      "id": "TC01",
      "name": "Single-bit rising and falling edges",
      "coverage": "first invocation, one bit set, one bit cleared, no change",
      "initial_state": "power-up, previous value treated as 0",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "value": 0
          },
          "expect": {
            "hasChanged": 0,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "no change from the initial zero value"
        },
        {
          "cycle": 1,
          "inputs": {
            "value": 1
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 1,
            "noOfRisingBits": 1,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "bit0 rises"
        },
        {
          "cycle": 2,
          "inputs": {
            "value": 1
          },
          "expect": {
            "hasChanged": 0,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "unchanged -> no edges"
        },
        {
          "cycle": 3,
          "inputs": {
            "value": 0
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 1,
            "fallingBits": 1,
            "noOfFallingBits": 1
          },
          "check": "bit0 falls"
        },
        {
          "cycle": 4,
          "inputs": {
            "value": 0
          },
          "expect": {
            "hasChanged": 0,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "unchanged"
        }
      ]
    },
    {
      "id": "TC02",
      "name": "Multiple simultaneous edges",
      "coverage": "several bits rise and fall in the same cycle, counts are correct",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "value": 15
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 15,
            "noOfRisingBits": 4,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "four bits rise at once"
        },
        {
          "cycle": 1,
          "inputs": {
            "value": 240
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 240,
            "noOfRisingBits": 4,
            "hasFallingEdges": 1,
            "fallingBits": 15,
            "noOfFallingBits": 4
          },
          "check": "four rise and four fall in the same cycle"
        },
        {
          "cycle": 2,
          "inputs": {
            "value": 255
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 15,
            "noOfRisingBits": 4,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "four more rise, none fall"
        },
        {
          "cycle": 3,
          "inputs": {
            "value": 0
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 1,
            "fallingBits": 255,
            "noOfFallingBits": 8
          },
          "check": "all eight fall"
        }
      ]
    },
    {
      "id": "TC03",
      "name": "Boundary bits and full word",
      "coverage": "bit31 (most significant), all 32 bits at once, maximum counts",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "value": 2147483648
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 2147483648,
            "noOfRisingBits": 1,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "bit31 rises"
        },
        {
          "cycle": 1,
          "inputs": {
            "value": 4294967295
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 2147483647,
            "noOfRisingBits": 31,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "the remaining 31 bits rise, count 31"
        },
        {
          "cycle": 2,
          "inputs": {
            "value": 4294967295
          },
          "expect": {
            "hasChanged": 0,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "unchanged"
        },
        {
          "cycle": 3,
          "inputs": {
            "value": 0
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 1,
            "fallingBits": 4294967295,
            "noOfFallingBits": 32
          },
          "check": "all 32 bits fall, count 32"
        },
        {
          "cycle": 4,
          "inputs": {
            "value": 4294967295
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 4294967295,
            "noOfRisingBits": 32,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "all 32 bits rise, count 32"
        }
      ]
    },
    {
      "id": "TC04",
      "name": "Alternating patterns",
      "coverage": "interleaved bit patterns, rising and falling masks are disjoint",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "value": 2863311530
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 2863311530,
            "noOfRisingBits": 16,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "16 odd bits rise"
        },
        {
          "cycle": 1,
          "inputs": {
            "value": 1431655765
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 1,
            "risingBits": 1431655765,
            "noOfRisingBits": 16,
            "hasFallingEdges": 1,
            "fallingBits": 2863311530,
            "noOfFallingBits": 16
          },
          "check": "16 rise, 16 fall simultaneously"
        },
        {
          "cycle": 2,
          "inputs": {
            "value": 1431655765
          },
          "expect": {
            "hasChanged": 0,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 0,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "unchanged"
        },
        {
          "cycle": 3,
          "inputs": {
            "value": 1431633920
          },
          "expect": {
            "hasChanged": 1,
            "hasRisingEdges": 0,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": 1,
            "fallingBits": 21845,
            "noOfFallingBits": 8
          },
          "check": "upper half kept, lower half falls"
        }
      ]
    }
  ]
}