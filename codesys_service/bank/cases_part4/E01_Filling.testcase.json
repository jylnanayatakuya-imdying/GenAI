     "cycle": 1,
     "inputs": {
      "bottleSensor": 1,
      "cleaningConfirmButton": 1,
      "fillingConfirmButton": 0,
      "cappingConfirmButton": 0,
      "packingConfirmButton": 0,
      "finishedButton": 0
