  {
   "id": "TC05",
   "name": "A confirm button held in advance does not skip a step",
   "coverage": "edge-triggered confirmation: a button already held when its step is reached must not advance it; a fresh rising edge is required",
   "initial_state": "power-up: step 0, all actuators off",
   "steps": [
    {
     "cycle": 0,
     "inputs": {
      "bottleSensor": 0,
      "cleaningConfirmButton": 1,
      "fillingConfirmButton": 0,
      "cappingConfirmButton": 0,
      "packingConfirmButton": 0,
      "finishedButton": 0
     },
     "expect": {
      "Pump_Motor": 0,
      "Filling_Valve": 0,
      "Capping_Machine": 0,
      "Packing_Machine": 0,
      "Completion_Light": 0
     },
     "check": "confirm pressed early, no bottle yet: nothing happens"
