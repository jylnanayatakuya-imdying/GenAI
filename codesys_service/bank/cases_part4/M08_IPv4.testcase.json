{
  "task_id": "M08_IPv4",
  "title": "IPv4 Parsing with Format and Range Checks",
  "pou": "M08_IPv4",
  "scan_ms": 20,
  "interface": [
    {
      "name": "ipText",
      "dir": "input",
      "type": "STRING(254)",
      "desc": "dotted-decimal IPv4 text"
    },
    {
      "name": "ipValue",
      "dir": "output",
      "type": "UDINT",
      "desc": "32-bit address, 0 when invalid"
    }
  ],
  "cases": [
    {
      "id": "TC01",
      "name": "Valid addresses in network byte order",
      "coverage": "typical address, first segment in the most significant byte, single digits, maximum segments",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "ipText": "192.168.1.1"
          },
          "expect": {
            "ipValue": 3232235777
          },
          "check": "typical address"
        },
        {
          "cycle": 1,
          "inputs": {
            "ipText": "1.2.3.4"
          },
          "expect": {
            "ipValue": 16909060
          },
          "check": "single digits, byte order check"
        },
        {
          "cycle": 2,
          "inputs": {
            "ipText": "255.255.255.255"
          },
          "expect": {
            "ipValue": 4294967295
          },
          "check": "all maximum segments"
        },
        {
          "cycle": 3,
          "inputs": {
            "ipText": "10.0.0.255"
          },
          "expect": {
            "ipValue": 167772415
          },
          "check": "zeros in the middle"
        },
        {
          "cycle": 4,
          "inputs": {
            "ipText": "127.0.0.1"
          },
          "expect": {
            "ipValue": 2130706433
          },
          "check": "loopback"
        }
      ]
    },
    {
      "id": "TC02",
      "name": "Zero address and leading zeros",
      "coverage": "0.0.0.0 produces 0, leading zeros accepted as decimal",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "ipText": "0.0.0.0"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "valid address 0.0.0.0 also produces 0"
        },
        {
          "cycle": 1,
          "inputs": {
            "ipText": "0.0.0.1"
          },
          "expect": {
            "ipValue": 1
          },
          "check": "smallest non-zero address"
        },
        {
          "cycle": 2,
          "inputs": {
            "ipText": "010.001.000.009"
          },
          "expect": {
            "ipValue": 167837705
          },
          "check": "leading zeros are still decimal"
        }
      ]
    },
    {
      "id": "TC03",
      "name": "Out-of-range segments",
      "coverage": "256, 999, and a value just above the limit are rejected",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "ipText": "256.1.1.1"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "first segment 256 > 255"
        },
        {
          "cycle": 1,
          "inputs": {
            "ipText": "1.256.1.1"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "second segment out of range"
        },
        {
          "cycle": 2,
          "inputs": {
            "ipText": "1.1.1.256"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "last segment out of range"
        },
        {
          "cycle": 3,
          "inputs": {
            "ipText": "999.999.999.999"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "all segments out of range"
        },
        {
          "cycle": 4,
          "inputs": {
            "ipText": "255.255.255.255"
          },
          "expect": {
            "ipValue": 4294967295
          },
          "check": "255 is still accepted"
        }
      ]
    },
    {
      "id": "TC04",
      "name": "Malformed input",
      "coverage": "wrong segment count, empty segments, non-digit characters, empty string",
      "initial_state": "power-up",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "ipText": "1.2.3"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "only three segments"
        },
        {
          "cycle": 1,
          "inputs": {
            "ipText": "1.2.3.4.5"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "five segments"
        },
        {
          "cycle": 2,
          "inputs": {
            "ipText": "1.2..4"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "empty segment"
        },
        {
          "cycle": 3,
          "inputs": {
            "ipText": ".1.2.3"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "leading period"
        },
        {
          "cycle": 4,
          "inputs": {
            "ipText": "1.2.3."
          },
          "expect": {
            "ipValue": 0
          },
          "check": "trailing period"
        },
        {
          "cycle": 5,
          "inputs": {
            "ipText": "1.2.3.a"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "non-digit character"
        },
        {
          "cycle": 6,
          "inputs": {
            "ipText": "192,168,1,1"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "wrong separator"
        },
        {
          "cycle": 7,
          "inputs": {
            "ipText": ""
          },
          "expect": {
            "ipValue": 0
          },
          "check": "empty string"
        },
        {
          "cycle": 8,
          "inputs": {
            "ipText": "1234"
          },
          "expect": {
            "ipValue": 0
          },
          "check": "no separators at all"
        },
        {
          "cycle": 9,
          "inputs": {
            "ipText": "1.2.3.4 "
          },
          "expect": {
            "ipValue": 0
          },
          "check": "trailing space is not a digit"
        }
      ]
    }
  ]
}