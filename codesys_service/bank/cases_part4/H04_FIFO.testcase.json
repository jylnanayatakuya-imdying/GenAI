{
  "task_id": "H04_FIFO",
  "title": "FIFO First-In-First-Out Queue",
  "pou": "H04_FIFO",
  "scan_ms": 20,
  "interface": [
    {
      "name": "enqueue",
      "dir": "input",
      "type": "BOOL",
      "desc": "enqueue request (rising edge)"
    },
    {
      "name": "dequeue",
      "dir": "input",
      "type": "BOOL",
      "desc": "dequeue request (rising edge)"
    },
    {
      "name": "reset",
      "dir": "input",
      "type": "BOOL",
      "desc": "reset the queue"
    },
    {
      "name": "item",
      "dir": "inout",
      "type": "INT",
      "desc": "value to enqueue / removed value"
    },
    {
      "name": "elementCount",
      "dir": "output",
      "type": "DINT",
      "desc": "current number of elements"
    },
    {
      "name": "status",
      "dir": "output",
      "type": "WORD",
      "desc": "0 ok, 16#8001 empty, 16#8002 full"
    }
  ],
  "cases": [
    {
      "id": "TC01",
      "name": "Basic enqueue and dequeue in FIFO order",
      "coverage": "one operation per rising edge, held signal does not repeat, values come out in insertion order",
      "initial_state": "power-up: queue empty, elementCount 0, capacity 5",
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "enqueue": 0,
            "dequeue": 0,
            "reset": 0
          },
          "expect": {
            "elementCount": 0,
            "status": 0
          },
          "check": "power-up: empty"
        },
        {
          "cycle": 1,
          "inputs": {
            "enqueue": 1,
            "dequeue": 0,
            "reset": 0,
            "item": 11
          },
          "expect": {
            "elementCount": 1,
            "status": 0
          },
          "check": "enqueue 11"
        },
        {
          "cycle": 2,
          "inputs": {
            "enqueue": 1,
            "dequeue": 0,
            "reset": 0,
            "item": 99
          },
          "expect": {
            "elementCount": 1
          },
          "check": "signal held -> no second enqueue"
        },
        {
          "cycle": 3,
          "inputs": {
            "enqueue": 0,
            "dequeue": 0,
            "reset": 0,
            "item": 99
          },
          "expect": {
            "elementCount": 1
          },
          "check": "released"
        },
        {
          "cycle": 4,
          "inputs": {
            "enqueue": 1,
            "dequeue": 0,
            "reset": 0,
            "item": 22
          },
          "expect": {
            "elementCount": 2
          },
          "check": "enqueue 22"
        },
        {
          "cycle": 5,
          "inputs": {
            "enqueue": 0,
            "dequeue": 0,
            "reset": 0
          },
          "expect": {
            "elementCount": 2
          },
          "check": "released"
        },
        {
          "cycle": 6,
          "inputs": {
            "enqueue": 0,
            "dequeue": 1,
            "reset": 0
          },
          "expect": {
            "elementCount": 1,
            "status": 0,
            "item": 11
          },
          "check": "dequeue returns the first value 11"
        },
        {
          "cycle": 7,
          "inputs": {
            "enqueue": 0,
            "dequeue": 0,
            "reset": 0
          },
          "expect": {
            "elementCount": 1
          },
          "check": "released"
        },
        {
          "cycle": 8,
          "inputs": {
            "enqueue": 0,
            "dequeue": 1,
            "reset": 0
          },
          "expect": {
            "elementCount": 0,
            "item": 22
          },
          "check": "dequeue returns 22, queue empty"
        }
      ]
    },
