{
  "task_id": "H01_Proportion",
  "title": "Material Proportioning Process Control",
  "pou": "H01_Proportion",
  "scan_ms": 20,
  "interface": [
    {
      "name": "estop",
      "dir": "input",
      "type": "BOOL",
      "desc": "FALSE = emergency stop triggered"
    },
    {
      "name": "opeMode",
      "dir": "input",
      "type": "BOOL",
      "desc": "FALSE manual / TRUE automatic"
    },
    {
      "name": "valveAStart",
      "dir": "input",
      "type": "BOOL",
      "desc": "valve A toggle button"
    },
    {
      "name": "valveBStart",
      "dir": "input",
      "type": "BOOL",
      "desc": "valve B toggle button"
    },
    {
      "name": "valveCStart",
      "dir": "input",
      "type": "BOOL",
      "desc": "valve C toggle button"
    },
    {
      "name": "valveDStart",
      "dir": "input",
      "type": "BOOL",
      "desc": "valve D toggle button"
    },
    {
      "name": "mixMotorStart",
      "dir": "input",
      "type": "BOOL",
      "desc": "mixing motor toggle button"
    },
    {
      "name": "autoStart",
      "dir": "input",
      "type": "BOOL",
      "desc": "automatic start button"
    },
    {
      "name": "processMode",
      "dir": "input",
      "type": "BOOL",
      "desc": "FALSE two materials / TRUE three materials"
    },
    {
      "name": "levelSensor",
      "dir": "input",
      "type": "INT",
      "desc": "liquid level in cm"
    },
    {
      "name": "mixMotorComplete",
      "dir": "input",
      "type": "BOOL",
      "desc": "mixing complete signal"
    },
    {
      "name": "valveARun",
      "dir": "output",
      "type": "BOOL",
      "desc": "valve A run"
    },
    {
      "name": "valveBRun",
      "dir": "output",
      "type": "BOOL",
      "desc": "valve B run"
    },
    {
      "name": "valveCRun",
      "dir": "output",
      "type": "BOOL",
      "desc": "valve C run"
    },
    {
      "name": "valveDRun",
      "dir": "output",
      "type": "BOOL",
      "desc": "valve D run"
    },
    {
      "name": "mixMotorRun",
      "dir": "output",
      "type": "BOOL",
      "desc": "mixing motor run"
