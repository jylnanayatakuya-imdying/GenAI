(* Q13 Office HVAC Multi-mode Energy-Saving Control - reference solution *)
FUNCTION_BLOCK FB_Q13
VAR_INPUT
    OCCUPANCY_DETECTED : BOOL;
    ENERGY_SAVING_MODE : BOOL;
    HVAC_MODE_SELECTOR : INT;
END_VAR
VAR_OUTPUT
    SUPPLY_FAN_RUN       : BOOL;
    TEMP_SETPOINT_ADJUST : INT;
END_VAR
VAR
    startTimer : TON;
END_VAR

startTimer(IN := OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3, PT := T#30S);
SUPPLY_FAN_RUN := OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3;

IF HVAC_MODE_SELECTOR = 3 THEN
    TEMP_SETPOINT_ADJUST := 4;
ELSIF OCCUPANCY_DETECTED THEN
    TEMP_SETPOINT_ADJUST := 0;
ELSIF HVAC_MODE_SELECTOR = 1 THEN
    TEMP_SETPOINT_ADJUST := 1;
ELSIF HVAC_MODE_SELECTOR = 2 THEN
    TEMP_SETPOINT_ADJUST := 4;
ELSIF ENERGY_SAVING_MODE THEN
    TEMP_SETPOINT_ADJUST := 3;
ELSE
    TEMP_SETPOINT_ADJUST := 2;
END_IF;
